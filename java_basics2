package demo;
import java.util.Scanner;
public class kd2 {

public static void main(String[] args) {
Scanner sc=new Scanner(System.in);
System.out.print("enter the units:");
int m=sc.nextInt();
if(m<=0){
      System.out.println("invalid");
      }
else if(m>=1 && m<=100){
System.out.println("Amount="+(m*1.5));
       }
       else if(m>=101 && m<=200){
System.out.println("Amount="+((100*1.5)+((m-100)*2.5)));
}
       else if(m>=201 && m<=300){
System.out.println("Amount="+((100*1.5)+((100*2.5)+((m-200)*3.5))));
}
       else if(m>=301 && m<=400){
System.out.println("Amount="+((100*1.5)+(100*2.5)+(100*3.5)+((m-300)*4.5)));
}
       else{
      System.out.println("Amount="+((100*1.5)+(100*2.5)+(100*3.5)+(100*4.5)+((m-400)*5)));

       }
}
}

